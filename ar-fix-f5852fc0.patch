+/* Every time, duration and length label in the chat is one line: a reply's or a prompt's time, a
+   Worked for or a command's time, a subagent's or a background task's, a video's length on its
+   thumbnail (Leo, 2026-11-14: "these times are still bad and going to next lines!", of a sent
+   video's "0:01" broken into "0:0" over "1"). Each is a short run of tabular digits that never
+   breaks; test/time-labels-one-line.test.ts finds every such class in the chat's CSS and fails on
+   one without this. */
+.cv-turn-time,
+.cv-user__time,
+.cv-time-hover,
+.cv-worked__time,
+.cv-worked__label-time,
+.cv-command__time,
+.cv-activity__time,
+.cv-waterfall__time,
+.cv-agentmsg__time,
+.cv-subagent__time,
+.cv-subagents__time,
+.cv-subagent-done__time,
+.cv-shimmer__lit-time,
+.cv-media__duration,
+.cv-video-frames__time,
+.cv-user__video-length,
+.acpmux-attachment-video-length,
+.acpmux-running-tray__time,
+.acpmux-agent-line__time,
+.acpmux-done-mark__time,
+.acpmux-bg__time,
+.acpmux-bg-card__time,
+.acpmux-agents-list__time {
+  white-space: nowrap;
+  font-variant-numeric: tabular-nums;
+}

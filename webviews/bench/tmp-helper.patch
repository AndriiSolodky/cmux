+/* The sub-pixel origin an anchored scroll write leaves (conversation/scrollCoordinates.ts), set on the
+   scroller and read only by the thread's `top`. Unregistered it inherited, so each new origin (an older
+   page landing above the reader writes one) restyled every node in the scroller: every mounted row and
+   the prompt rail, 100+ ms a page on a long chat. It does not inherit; the spacer and the thread take it
+   explicitly, so a new origin restyles those two and nothing they hold. */
+@property --acpmux-scroll-origin {
+  syntax: "<length>";
+  inherits: false;
+  initial-value: 0px;
+}
+.acpmux-spacer,
+.acpmux-thread {
+  --acpmux-scroll-origin: inherit;
+}
 /* --cv-inset-end: the column's end, moved in while the computer use live preview shows beside it

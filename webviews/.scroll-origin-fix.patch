 .acpmux-thread {
   transition: none;
 }
+/* The scroll origin (conversation/scrollCoordinates.ts) is the sub-pixel remainder of the scroller's
+   offset, written on the scroller as a reply streams at the bottom; only the thread's `top` reads it.
+   It does not inherit: as an inherited property each write restyled every element under the
+   scroller, some 1,500 in a long chat, per streamed token. The spacer and the thread take it on by
+   name, so a write restyles the scroller, its children and the thread, never the rows. */
+@property --acpmux-scroll-origin {
+  syntax: "<length>";
+  inherits: false;
+  initial-value: 0px;
+}
+.acpmux-spacer,
+.acpmux-thread {
+  --acpmux-scroll-origin: inherit;
+}
